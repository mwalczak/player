<?xml version="1.0" encoding="utf-8"?>
<!-- Most Xtream Codes servers only speak plain HTTP, so cleartext must be allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
